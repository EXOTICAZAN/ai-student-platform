# =============================================================================
# EduForge AI — environment template
#
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored; never commit real credentials.
#
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser. Only put values
# there that are safe to expose.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Project URL and anon key: Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security, so it must never be prefixed with
# NEXT_PUBLIC_ or imported into a client component.
# Needed for writes to the scholarship reference tables, whose RLS policies
# require the service_role, by scripts/reembed-chunks.mjs, and for
# Settings -> Delete my account (removing the auth user needs the service role;
# without it that button reports that deletion is not enabled).
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq -------------------------------------------------------------------
# Drives the tutor, note generation, flashcards, quizzes, the study planner
# and the scholarship advisor. Groq speaks the OpenAI wire format, so the
# `openai` package is pointed at https://api.groq.com/openai/v1.
GROQ_API_KEY=

# Optional server-only YouTube Data API v3 key. When set, course generation
# searches for one embeddable video per lesson and stores an exact watch URL.
# If absent or unavailable, generation keeps the safe YouTube search URL.
# Never prefix this with NEXT_PUBLIC_ or expose it to client code.
YOUTUBE_API_KEY=

# Optional model overrides. Defaults are the models verified against this
# project's key — the catalogue differs per key, so check /openai/v1/models
# before changing them:
#   GROQ_CHAT_MODEL -> qwen/qwen3.8-27b      (streaming tutor; no reasoning overhead)
#   GROQ_JSON_MODEL -> openai/gpt-oss-120b   (structured output)
# GROQ_CHAT_MODEL=
# GROQ_JSON_MODEL=
# GROQ_CHAT_MAX_TOKENS=4096

# --- Embeddings -------------------------------------------------------------
# Retrieval embeddings run locally via transformers.js — no API key, and
# document text never leaves the server. Groq offers no embeddings endpoint.
#
# The model determines the vector width, which is baked into the
# document_chunks.embedding column. Changing EMBEDDING_MODEL therefore needs a
# matching migration plus a re-embed; see supabase/migrations/003.
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
#
# Cache location for the downloaded model. Defaults to
# ~/.cache/eduforge-embeddings. Do NOT point this inside the project root:
# Turbopack traces every file under the root and panics on the ~90 MB .onnx.
# EMBEDDING_CACHE_DIR=

# --- Rate limiting (optional) ----------------------------------------------
# Without these the limiter counts in memory, per server instance. Set both to
# share one global count across instances (Upstash Redis REST credentials).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Site -------------------------------------------------------------------
# Canonical origin used for metadataBase, sitemap.xml and robots.txt.
# Must be set in production or Open Graph URLs resolve against localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin ------------------------------------------------------------------
# Comma-separated allowlist of authenticated email addresses. Server-only.
# Never prefix this with NEXT_PUBLIC_.
ADMIN_EMAILS=
